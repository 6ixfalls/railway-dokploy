diff --git a/packages/server/src/lib/cloud-url.ts b/packages/server/src/lib/cloud-url.ts
new file mode 100644
--- /dev/null
+++ b/packages/server/src/lib/cloud-url.ts
@@ -0,0 +1,22 @@
+/** Resolve the cloud dashboard origin at runtime, without baking it into bundles. */
+export const getCloudUrl = (): string => {
+	const configuredUrl = process.env.PUBLIC_URL || process.env.SITE_URL;
+	if (!configuredUrl) {
+		if (process.env.NODE_ENV === "development") {
+			return "http://localhost:3000";
+		}
+		throw new Error("Set PUBLIC_URL or SITE_URL to the cloud dashboard origin");
+	}
+	const url = new URL(configuredUrl);
+	if (
+		!["http:", "https:"].includes(url.protocol) ||
+		url.username ||
+		url.password ||
+		url.pathname !== "/" ||
+		url.search ||
+		url.hash
+	) {
+		throw new Error("PUBLIC_URL or SITE_URL must be an HTTP(S) origin without a path");
+	}
+	return url.origin;
+};
